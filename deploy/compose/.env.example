# Every variable compose.yaml interpolates, with lab-only values for a stack bound to your machine.
# compose.yaml falls back to these same values, so .env is optional: `cp .env.example .env` and edit it to
# override them; .env is git-ignored. Never reuse them anywhere else: in the cloud, passwords come from
# Secret Manager (C5 #ct5-env).
#
# One variable per database, never one shared (C5 #ct5-config). Each feeds both its PostgreSQL container
# and the services that connect to it, so the two sides cannot drift apart.

# lockdb, user lockapp; read by lock-server.
SPRING_DATASOURCE_PASSWORD=lab-only-lockdb

# paydb, user payapp; read by payment-resource and rail-proxy.
PAYMENTS_DATASOURCE_PASSWORD=lab-only-paydb
