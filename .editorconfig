# Formatting is enforced by Spotless + google-java-format; this file keeps
# editors from fighting it before the build exists.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 2
max_line_length = 100

[*.{kt,kts}]
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
max_line_length = 100

[*.{tf,tfvars}]
indent_size = 2

[Makefile]
indent_style = tab
